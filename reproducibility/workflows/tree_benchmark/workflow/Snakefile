configfile: "config.yaml"

import os

# read config
n_cells = config["n_cells"]
p_change = config["p_change"]
seeds = list(range(config["seeds"]))
methods = config["method"]
tree_types = config["tree_type"]
results_dir = config["results_dir"]

rule all:
    input:
        os.path.join(results_dir, "res_merged.csv"),
        os.path.join(results_dir, "plots.pdf")

rule simulate_data:
    output:
        dist_mat=temp(os.path.join(results_dir, "dm_n{n}_p{p}_s{s}_{t}.npy")),
        tree_nwk=temp(os.path.join(results_dir, "tree_n{n}_p{p}_s{s}_{t}.nwk"))
    conda:
        "cellmates"
    params:
        n_cells=lambda wildcards: wildcards.n,
        p_change=lambda wildcards: wildcards.p,
        seed=lambda wildcards: wildcards.s,
        tree_type=lambda wildcards: wildcards.t
    script: "scripts/simulate_data.py"

rule run_method:
    input:
        dist_mat=os.path.join(results_dir, "dm_n{n}_p{p}_s{s}_{t}.npy"),
        tree_nwk=os.path.join(results_dir, "tree_n{n}_p{p}_s{s}_{t}.nwk")
    output:
        os.path.join(results_dir, "res_n{n}_p{p}_s{s}_{m}_{t}.csv")
    conda:
        "cellmates"
    params:
        n_cells=lambda wildcards: wildcards.n,
        p_change=lambda wildcards: wildcards.p,
        method=lambda wildcards: wildcards.m,
        seed=lambda wildcards: wildcards.s,
        tree_type=lambda wildcards: wildcards.t
    script: "scripts/save_res.py"

rule merge_and_plot:
    input:
        expand(os.path.join(results_dir, "res_n{n}_p{p}_s{s}_{m}_{t}.csv"),
               n=n_cells,
               p=p_change,
               s=seeds,
               m=methods,
               t=tree_types)
    output:
        csv_file=os.path.join(results_dir, "res_merged.csv"),
        plot_file=os.path.join(results_dir, "plots.pdf")
    conda:
        "cellmates"
    script: "scripts/merge_and_plot.py"
