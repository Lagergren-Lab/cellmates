configfile: "config/config.yaml"

import os

# read config
n_cells = config["n_cells"]
p_change = config["p_change"]
seeds = list(range(config["seeds"]))
methods = config["method"]
tree_types = config["tree_type"]
results_dir = config["results_dir"]

rule all:
    input:
        os.path.join(results_dir, "res_merged.csv"),
        os.path.join(results_dir, "plots.pdf"),
        expand(os.path.join(results_dir, "plots", "dataset_n{n}_p{p}_{t}.png"),
               n=n_cells,
               p=p_change,
               t=tree_types
        )

rule simulate_data:
    output:
        dist_mat=temp(os.path.join(results_dir, "partials", "dm_n{n}_p{p}_s{s}_{t}.npy")),
        tree_nwk=temp(os.path.join(results_dir, "partials", "tree_n{n}_p{p}_s{s}_{t}.nwk"))
    conda:
        "envs/cellmates-min.yaml"
    params:
        n_cells=lambda wildcards: int(wildcards.n),
        p_change=lambda wildcards: float(wildcards.p),
        seed=lambda wildcards: int(wildcards.s),
        tree_type=lambda wildcards: wildcards.t
    script: "scripts/simulate_data.py"

# only plot one example dataset for each parameter setting (seed=0)
rule plot_dataset:
    output:
        os.path.join(results_dir, "plots", "dataset_n{n}_p{p}_{t}.png")
    conda:
        "envs/cellmates-min-scgenome.yaml"
        # "cellmates"
    params:
        n_cells=lambda wildcards: int(wildcards.n),
        p_change=lambda wildcards: float(wildcards.p),
        seed=0,
        tree_type=lambda wildcards: wildcards.t,
    script: "scripts/plot_dataset.py"

rule run_method:
    input:
        dist_mat=os.path.join(results_dir, "partials", "dm_n{n}_p{p}_s{s}_{t}.npy"),
        tree_nwk=os.path.join(results_dir, "partials", "tree_n{n}_p{p}_s{s}_{t}.nwk")
    output:
        os.path.join(results_dir, "partials", "res_n{n}_p{p}_s{s}_{m}_{t}.csv")
    conda:
        "envs/cellmates-min.yaml"
    params:
        n_cells=lambda wildcards: int(wildcards.n),
        p_change=lambda wildcards: float(wildcards.p),
        method=lambda wildcards: wildcards.m,
        seed=lambda wildcards: int(wildcards.s),
        tree_type=lambda wildcards: wildcards.t
    script: "scripts/save_res.py"

rule merge_and_plot:
    input:
        expand(os.path.join(results_dir, "partials", "res_n{n}_p{p}_s{s}_{m}_{t}.csv"),
               n=n_cells,
               p=p_change,
               s=seeds,
               m=methods,
               t=tree_types)
    output:
        csv_file=os.path.join(results_dir, "res_merged.csv"),
        plot_file=os.path.join(results_dir, "plots.pdf")
    conda:
        "envs/cellmates-min.yaml"
    script: "scripts/merge_and_plot.py"
